{
  "expo": {
    "name": "Ev Karnesi",
    "slug": "ev-karnesi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "evkarnesi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAF8F5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.acktechs.evkarnesi"
    },
    "android": {
      "package": "com.acktechs.evkarnesi",
      "adaptiveIcon": { "backgroundColor": "#1B5E4A" },
      "edgeToEdgeEnabled": true
    },
    "web": { "bundler": "metro" },
    "plugins": ["expo-font"]
  }
}
